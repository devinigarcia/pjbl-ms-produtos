# Copie este arquivo para ".env" e ajuste os valores. O .env NÃO vai para o Git.
# Todos os valores abaixo são fictícios.

# Porta HTTP do serviço
PORT=3001

# Connection string do MongoDB (Atlas ou local).
# Deixe vazio para subir com o repositório em memória (os dados somem ao encerrar).
# Exemplo Atlas: mongodb+srv://USUARIO:SENHA@nome-do-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Nome do banco dentro do cluster
MONGODB_DB=pjbl_produtos

# mongo | memory. Se ficar vazio: usa "mongo" quando MONGODB_URI existir, senão "memory".
DB_DRIVER=

# Chave interna compartilhada com o BFF e a Azure Function (cabeçalho x-api-key).
# Vazio = serviço aberto (só para desenvolvimento). Na nuvem, gere um valor longo e aleatório.
INTERNAL_API_KEY=

# Origens liberadas no CORS: "*" ou uma lista separada por vírgula
CORS_ORIGIN=*

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# URL pública do serviço (aparece em "Servers" no Swagger). Ex.: https://ms-produtos.exemplo.com
PUBLIC_URL=
